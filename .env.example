# Copy to .env and adjust. Never commit the real .env file.

# Address the web UI listens on. Default is local only.
# Set to 0.0.0.0 ONLY if you want other machines on your network to reach it
# (and put it behind something you trust; GameDock has no login yet).
GAMEDOCK_HOST=127.0.0.1
GAMEDOCK_PORT=8080

# Where game definition files (*.yaml) live.
GAMEDOCK_CATALOG_DIR=./catalog

# Where per-server data (saves, configs) is stored. Relative volume paths in a
# game definition are placed under <DATA_DIR>/<game id>/.
GAMEDOCK_DATA_DIR=./data

# "docker" talks to the local Docker engine through the docker CLI.
# "fake" is an in-memory pretend engine for development and tests.
GAMEDOCK_BACKEND=docker

# How many backups to keep per server (oldest are removed after each new backup).
GAMEDOCK_BACKUP_RETENTION=10

# Seconds a game server gets to save and exit when stopped (docker stop -t). Palworld/Minecraft saves can
# take a while; raise it for big worlds. Also set on the container so a host shutdown waits as long.
GAMEDOCK_STOP_TIMEOUT=60

# --- Monitoring (built in, in-memory, no database) ---
# Background sampler that feeds the sparklines. Costs one small docker call per
# interval (two while a server is running), however many servers you have.
GAMEDOCK_STATS_ENABLED=true
GAMEDOCK_STATS_INTERVAL=10
# How much history to keep in memory (seconds). At most ~2000 points per server are kept.
GAMEDOCK_STATS_HISTORY_SECONDS=3600

# Prometheus text endpoint at /metrics. Off by default.
GAMEDOCK_METRICS_ENABLED=false
# /metrics only answers requests from this machine (127.0.0.1) unless you set this to true.
# Set it true only if Prometheus runs elsewhere AND you also set GAMEDOCK_HOST so GameDock is reachable.
GAMEDOCK_METRICS_ALLOW_REMOTE=false

# --- MCP endpoint (lets AI agents manage servers over the Model Context Protocol, at /mcp) ---
# off        = nothing is served
# read_only  = tools that only look (catalog, status, stats, backup lists, config reads)
# standard   = everything except destructive tools (deploy, start/stop, settings, backups, config edits)  [default]
# full       = also delete/restore/wipe tools, each behind a two-step confirmation
# If GAMEDOCK_HOST is not localhost and no token is set below, MCP is forced to "off".
GAMEDOCK_MCP_MODE=standard
# Optional bearer token. Clients send "Authorization: Bearer <token>". Pick a long random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
GAMEDOCK_MCP_TOKEN=
# Extra Host / Origin values /mcp accepts (comma separated), for example when you reach GameDock by a
# LAN name: GAMEDOCK_MCP_ALLOWED_HOSTS=gamedock.lan:8080
GAMEDOCK_MCP_ALLOWED_HOSTS=
GAMEDOCK_MCP_ALLOWED_ORIGINS=
