# Settings for the system service (/etc/gamedock/gamedock.env). One KEY=value per line, no quotes needed.
# Never commit the real file. See .env.example in the project for every setting and its explanation.
GAMEDOCK_BACKEND=docker
GAMEDOCK_HOST=127.0.0.1
GAMEDOCK_PORT=8080
GAMEDOCK_DATA_DIR=/var/lib/gamedock
GAMEDOCK_CATALOG_DIR=/opt/gamedock/app/catalog
# MCP for AI agents: standard is the default. Set a token, even on localhost, if other people use this machine.
GAMEDOCK_MCP_MODE=standard
GAMEDOCK_MCP_TOKEN=
