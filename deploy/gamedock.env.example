# Settings for the system service (/etc/gamedock/gamedock.env). One KEY=value per line, no quotes needed.
# Never commit the real file. See .env.example in the project for every setting and its explanation.
GAMEDOCK_BACKEND=docker
GAMEDOCK_HOST=127.0.0.1
GAMEDOCK_PORT=8080
GAMEDOCK_DATA_DIR=/var/lib/gamedock
GAMEDOCK_CATALOG_DIR=/opt/gamedock/app/catalog
# MCP for AI agents: standard is the default. Set a token, even on localhost, if other people use this machine.
GAMEDOCK_MCP_MODE=standard
GAMEDOCK_MCP_TOKEN=

# Scheduled backups and maintenance (the Schedules page). false = keep the settings but run nothing.
GAMEDOCK_SCHEDULER=true
# Look on GitHub (read-only) for a newer GameDock: at most every 6 hours and on the Check now button.
# false = never contact GitHub (or the Steam data service, see below).
GAMEDOCK_UPDATE_CHECK=true
GAMEDOCK_UPDATE_REPO=jacobbweber/GameDock
# Steam game versions: where the newest build ids come from (a public mirror of Steam's data; read-only, cached for
# an hour). {appid} is replaced by the game's Steam app id. GAMEDOCK_UPDATE_CHECK=false switches this off too.
GAMEDOCK_STEAM_INFO_URL=https://api.steamcmd.net/v1/info/{appid}
# false = hide the "Update GameDock" button (the version and badge stay).
GAMEDOCK_SELF_UPDATE=true
